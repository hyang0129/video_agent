# YouTube Data API v3
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM Provider: "claude" (default if ANTHROPIC_API_KEY is set) or "google"
# LLM_PROVIDER=claude

# Anthropic Claude (default LLM provider)
# Get your API key from: https://console.anthropic.com/settings/keys
# Default model: claude-haiku-4-5-20251001 (fastest/cheapest)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Google AI Studio (fallback LLM provider)
# Get your API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1M tokens/day, 1500 requests/day
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-1.5-flash

# Optional: Cache settings
ENABLE_CACHE=true
CACHE_EXPIRE_HOURS=24

# Audio Agent (ElevenLabs TTS)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Visual Agent (Pexels image search - optional)
# Get your API key from: https://www.pexels.com/api/
PEXELS_API_KEY=

# Rhubarb Lip Sync (Linux default; override on other platforms)
# RHUBARB_PATH=/workspaces/hub/tools/bin/rhubarb

# Live2D Renderer
# LIVE2D_RENDER_PATH=/workspaces/hub/tools/bin/live2d-render
# LIVE2D_MODEL_ID=majo
# LIVE2D_MODEL_PATH=/workspaces/hub/repos/live2d/assets/models/majo/majo.model3.json
