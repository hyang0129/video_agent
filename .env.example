# =============================================================================
# Video Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# At minimum you need: ANTHROPIC_API_KEY (or GOOGLE_API_KEY) + a running
# Chatterbox TTS server for voiceover generation.
# =============================================================================

# --- LLM Provider -----------------------------------------------------------

# LLM Provider: "claude" (default if ANTHROPIC_API_KEY is set) or "google"
# LLM_PROVIDER=claude

# Anthropic Claude (default LLM)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Google AI Studio (alternative LLM)
# https://aistudio.google.com/app/apikey — free tier available
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-flash-latest

# --- API Keys ---------------------------------------------------------------

# YouTube Data API v3 (market research agent)
# https://console.cloud.google.com/apis/credentials — enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Pexels (image retrieval — optional, falls back to placeholder BMPs)
# https://www.pexels.com/api/
# PEXELS_API_KEY=

# ElevenLabs TTS (only needed if TTS_BACKEND=elevenlabs)
# https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=

# --- TTS / Chatterbox -------------------------------------------------------

# TTS backend: "chatterbox_server" (default) | "chatterbox_direct" | "elevenlabs"
# TTS_BACKEND=chatterbox_server

# Chatterbox server URL (must be running separately — see https://github.com/hyang0129/chatterbox)
# CHATTERBOX_SERVER_URL=http://localhost:8000

# Voice preset for Chatterbox TTS
# CHATTERBOX_VOICE=kronimi7030

# Auto-start support (optional — lets the pipeline start the Chatterbox server itself)
# CHATTERBOX_APP_DIR=       # Root of the chatterbox repo (contains app/main.py)
# CHATTERBOX_UVICORN=       # Path to uvicorn in the chatterbox venv

# --- Rhubarb Lip Sync (optional) --------------------------------------------

# Path to rhubarb binary. Lip-sync degrades to silent neutral pose if absent.
# https://github.com/DanielSWolf/rhubarb-lip-sync
# RHUBARB_PATH=

# --- Live2D Avatar Rendering (optional) -------------------------------------

# LIVE2D_RENDER_PATH=       # Path to live2d-render binary (built from repos/live2d)
# LIVE2D_REPO_ROOT=         # Root of the live2d repo (working directory for asset resolution)
# LIVE2D_MODEL_ID=majo
# LIVE2D_MODEL_PATH=        # Full path to the .model3.json model file

# --- Music Generation (ACE-Step — optional) -----------------------------------

# Music backend: "default" (bundled MP3) | "acestep" (AI-generated)
# MUSIC_BACKEND=default

# ACE-Step server URL (only needed when MUSIC_BACKEND=acestep)
# ACESTEP_BASE_URL=http://localhost:8001

# Path to local ace-step-client package (dev-container only)
# Install with: pip install -e "$ACE_STEP_CLIENT_PATH"
# ACE_STEP_CLIENT_PATH=/workspaces/hub/repos/ace_step

# --- Cache & Paths (usually fine as defaults) --------------------------------

# ENABLE_CACHE=true
# CACHE_EXPIRE_HOURS=24
# VIDEO_AGENT_CACHE_DIR=.cache
# VIDEO_AGENT_RESULTS_DIR=results
# VIDEO_AGENT_ASSETS_DIR=assets
